# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.deadmanoz/
.claude/
.cursor/

# Dolt database files (added by bd init)
.dolt/
*.db

# Playwright MCP scratchpad (snapshots, console logs)
.playwright-mcp/
.playwright-cli/

# Playwright test runner artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Draft sibling posts (kept locally, not published)
*.draft.md

# Generated before build and dev by scripts/generate-rss.ts (npm prebuild/predev)
/public/feed.xml
/public/atom.xml
